{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_ROOT=/Users/lucky/Code/pacific-gym/plugins/pacific-gym python3 /Users/lucky/Code/pacific-gym/plugins/pacific-gym/hooks/session_start.py",
            "statusMessage": "Checking Pacific Gym plugin"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_ROOT=/Users/lucky/Code/pacific-gym/plugins/pacific-gym python3 /Users/lucky/Code/pacific-gym/plugins/pacific-gym/hooks/post_tool_use.py",
            "timeout": 600,
            "statusMessage": "Comparing Pacific Gym candidate or keyframe"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_ROOT=/Users/lucky/Code/pacific-gym/plugins/pacific-gym python3 /Users/lucky/Code/pacific-gym/plugins/pacific-gym/hooks/stop_guard.py",
            "timeout": 10,
            "statusMessage": "Checking Pacific Gym acceptance evidence"
          }
        ]
      }
    ]
  }
}
