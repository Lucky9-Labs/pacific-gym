{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/session_start.py",
            "statusMessage": "Checking Pacific Gym plugin"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/post_tool_use.py",
            "timeout": 600,
            "statusMessage": "Comparing Pacific Gym candidate or keyframe"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/stop_guard.py",
            "timeout": 10,
            "statusMessage": "Checking Pacific Gym acceptance evidence"
          }
        ]
      }
    ]
  }
}
