#!/bin/sh
# Shared by this repository's linked worktrees. Never overwrite local env files.
root=$(git rev-parse --show-toplevel) || exit 0
common=$(git rev-parse --path-format=absolute --git-common-dir) || exit 0
[ "$(basename "$common")" = .git ] || exit 0
source_env="$(dirname "$common")/.env"
[ -e "$root/.env" ] || [ -L "$root/.env" ] || {
  [ ! -f "$source_env" ] || ln -s "$source_env" "$root/.env"
}
exit 0
